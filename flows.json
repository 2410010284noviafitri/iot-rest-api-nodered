    {
        "id": "664b022077603ec2",
        "type": "function",
        "z": "flow_api",
        "name": "Set Threshold",
        "func": "var max = parseFloat((msg.payload || {}).max);\nmsg.headers = { 'Access-Control-Allow-Origin': '*' };\nif (isNaN(max)) {\n    msg.statusCode = 400;\n    msg.payload = { status: 'error', message: 'max harus angka' };\n    return msg;\n}\nflow.set('threshold', max);\nmsg.statusCode = 200;\nmsg.payload = { status: 'success', message: 'Batas suhu diset', threshold: max };\nreturn msg;",
