    {
        "id": "mqtt_sensor_in",
        "type": "mqtt in",
        "z": "flow_api",
        "name": "Subscribe Sensor",
        "topic": "iot/sensor",
        "qos": "0",
        "datatype": "json",
        "broker": "mqtt_broker_config",
        "inputs": 0,
        "x": 170,
        "y": 100,
        "wires": [
            [
                "store_sensor"
            ]
