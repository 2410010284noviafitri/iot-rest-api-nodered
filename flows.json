    {
        "id": "store_sensor",
        "type": "function",
        "z": "flow_api",
        "name": "Simpan Data Sensor",
        "func": "var data = msg.payload;\ndata.received = new Date().toISOString();\nvar batas = flow.get('threshold');\ndata.alert = (batas !== undefined && data.suhu > batas);\nflow.set('lastSensor', data);\n\nvar dbMsg = {\n    topic: \"INSERT INTO sensor (suhu, kelembaban, waktu) VALUES (\" +\n        Number(data.suhu) + \", \" + Number(data.kelembaban) + \", '\" + data.received + \"')\"\n};\n\nvar notif = null;\nif (data.alert) {\n    notif = {\n        topic: 'iot/alert', payload: {\n            pesan: 'Suhu ' + data.suhu + ' C melewati batas ' + batas + ' C',\n            waktu: data.received\n        }\n    };\n}\nreturn [msg, notif, dbMsg];",
        "outputs": 3,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 120,
        "wires": [
            [
                "debug_sensor",
                "d07a2964d287174b"
            ],
            [
                "a43ae7c5e19a7065"
            ],
            [
                "fbc22b44ec0fb046",
                "39f12e83ba868ea8"
            ]
        ]
    },
